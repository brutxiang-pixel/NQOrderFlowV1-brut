<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- 关键：让 SDK 引入桌面框架引用（含 System.Drawing.Common / WindowsBase 等） -->
		<UseWindowsForms>true</UseWindowsForms>

		<!-- ATAS 安装目录 -->
		<ATASPlatformDir>$(MSBuildProgramFiles32)\ATAS Platform</ATASPlatformDir>

		<!-- 如果 WindowsBase 冲突仍然出现（通常是警告），先压掉，避免刷屏 -->
		<NoWarn>$(NoWarn);MSB3277</NoWarn>
	</PropertyGroup>

	<!--
		This project compiles the OPFStrategyV1 strategy source files directly into the same deployed
		ATAS strategy DLL (NQOrderFlowV1.dll) instead of referencing OPFStrategyV1.dll via ProjectReference.
		The default SDK implicit Compile glob only excludes this project's own bin/obj folders; it does NOT
		exclude OPFStrategyV1's own bin/obj, and it does NOT exclude the standalone console test projects
		under OPFStrategyV1/Scripts/tests (each has its own Program.cs top-level statements and references
		OPFStrategyV1.csproj via ProjectReference). These must be excluded explicitly, otherwise the build
		fails with CS8802 (duplicate top-level statements) and CS0579 (duplicate AssemblyInfo attributes).
	-->
	<ItemGroup>
		<Compile Remove="OPFStrategyV1\bin\**\*.cs" />
		<Compile Remove="OPFStrategyV1\obj\**\*.cs" />
		<Compile Remove="OPFStrategyV1\Scripts\tests\**\*.cs" />
		<Compile Remove="OPFStrategyV1\Evidence\**\*.cs" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="ATAS.DataFeedsCore">
			<HintPath>$(ATASPlatformDir)\ATAS.DataFeedsCore.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="ATAS.Indicators">
			<HintPath>$(ATASPlatformDir)\ATAS.Indicators.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="ATAS.Strategies">
			<HintPath>$(ATASPlatformDir)\ATAS.Strategies.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="OFT.Rendering">
			<HintPath>$(ATASPlatformDir)\OFT.Rendering.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Utils.Common">
			<HintPath>$(ATASPlatformDir)\Utils.Common.dll</HintPath>
		</Reference>
	</ItemGroup>

	<Target Name="CopyToATAS" AfterTargets="Build">
		<Copy SourceFiles="$(TargetPath)"
			  DestinationFolder="$(APPDATA)\ATAS\Strategies"
			  OverwriteReadOnlyFiles="true" />
	</Target>

</Project>