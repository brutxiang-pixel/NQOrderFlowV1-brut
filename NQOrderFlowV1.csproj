<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- 关键：让 SDK 引入桌面框架引用（含 System.Drawing.Common / WindowsBase 等） -->
		<UseWindowsForms>true</UseWindowsForms>

		<!-- ATAS 安装目录 -->
		<ATASPlatformDir>$(MSBuildProgramFiles32)\ATAS Platform</ATASPlatformDir>

		<!-- 如果 WindowsBase 冲突仍然出现（通常是警告），先压掉，避免刷屏 -->
		<NoWarn>$(NoWarn);MSB3277</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="ATAS.DataFeedsCore">
			<HintPath>$(ATASPlatformDir)\ATAS.DataFeedsCore.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="ATAS.Indicators">
			<HintPath>$(ATASPlatformDir)\ATAS.Indicators.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="ATAS.Strategies">
			<HintPath>$(ATASPlatformDir)\ATAS.Strategies.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="OFT.Rendering">
			<HintPath>$(ATASPlatformDir)\OFT.Rendering.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<Target Name="CopyToATAS" AfterTargets="Build">
		<Copy SourceFiles="$(TargetPath)"
			  DestinationFolder="$(APPDATA)\ATAS\Strategies"
			  OverwriteReadOnlyFiles="true" />
	</Target>

</Project>